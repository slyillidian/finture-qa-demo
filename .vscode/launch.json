{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Link Probe QA",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/example/lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": [
        "--dart-define=QA_PROBE=true"
      ],
      "env": {
        "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer"
      },
      "cwd": "${workspaceFolder}/example",
      "debuggerType": "flutter"
    }
  ]
}
